{
  "$defs": {
    "ExecutionEnvironment": {
      "description": "Supported execution environments.",
      "enum": [
        "local",
        "kubernetes",
        "gpu_cluster"
      ],
      "title": "ExecutionEnvironment",
      "type": "string"
    },
    "GpuRequest": {
      "additionalProperties": false,
      "description": "Request for GPUs.\n\nThere is intentionally no duration field. A lease is released only after\nthe associated execution pod or job is confirmed terminated.",
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Architecture"
        },
        "count": {
          "maximum": 8,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "environment": {
          "$ref": "#/$defs/ExecutionEnvironment",
          "default": "gpu_cluster"
        },
        "image_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Digest"
        },
        "minimum_memory_mb": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Memory Mb"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "gpu-request.v1",
          "default": "gpu-request.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "topology": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topology"
        }
      },
      "required": [
        "request_id",
        "task_id",
        "count"
      ],
      "title": "GpuRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An execution shape requested without a predicted duration.",
  "properties": {
    "artifact_byte_limit": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Byte Limit"
    },
    "artifact_request_ids": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Request Ids",
      "type": "array"
    },
    "candidate_digest": {
      "title": "Candidate Digest",
      "type": "string"
    },
    "command": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Command",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "environment": {
      "$ref": "#/$defs/ExecutionEnvironment"
    },
    "gpu": {
      "anyOf": [
        {
          "$ref": "#/$defs/GpuRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "image_digest": {
      "title": "Image Digest",
      "type": "string"
    },
    "image_repository": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Repository"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "network_access": {
      "default": false,
      "title": "Network Access",
      "type": "boolean"
    },
    "node_id": {
      "title": "Node Id",
      "type": "string"
    },
    "repository": {
      "title": "Repository",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "schema_version": {
      "const": "execution-request.v1",
      "default": "execution-request.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "timeout_seconds": {
      "default": 1800,
      "maximum": 86400,
      "minimum": 1,
      "title": "Timeout Seconds",
      "type": "integer"
    },
    "workspace_lease_id": {
      "title": "Workspace Lease Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "task_id",
    "node_id",
    "repository",
    "workspace_lease_id",
    "candidate_digest",
    "command",
    "environment",
    "image_digest",
    "idempotency_key"
  ],
  "title": "ExecutionRequest",
  "type": "object"
}
