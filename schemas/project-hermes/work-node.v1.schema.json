{
  "$defs": {
    "LifecycleStatus": {
      "description": "Coarse control-plane lifecycle states.\n\nTechnical activities such as locating, reproducing, planning, and\nvalidating are capabilities, not lifecycle states.",
      "enum": [
        "DISCOVERED",
        "QUEUED",
        "CLAIMED",
        "RUNNING",
        "WAITING_RESOURCE",
        "WAITING_ARTIFACT",
        "WAITING_REVIEW",
        "WAITING_APPROVAL",
        "COMPLETED",
        "BLOCKED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "LifecycleStatus",
      "type": "string"
    },
    "ProjectRole": {
      "description": "Security identities recognized by the control plane.",
      "enum": [
        "control_plane",
        "campaign_hermes",
        "project_hermes",
        "codex",
        "runner",
        "reviewer",
        "curator",
        "operator"
      ],
      "title": "ProjectRole",
      "type": "string"
    },
    "WorkNodeKind": {
      "description": "Generic node types accepted by the controller.",
      "enum": [
        "agent_invocation",
        "tool_call",
        "execution",
        "review",
        "approval"
      ],
      "title": "WorkNodeKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One independently claimable unit of work.",
  "properties": {
    "capability": {
      "title": "Capability",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dependencies": {
      "items": {
        "type": "string"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "kind": {
      "$ref": "#/$defs/WorkNodeKind"
    },
    "lease_expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Expires At"
    },
    "node_id": {
      "title": "Node Id",
      "type": "string"
    },
    "output": {
      "additionalProperties": true,
      "title": "Output",
      "type": "object"
    },
    "owner_token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner Token"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "repository": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repository"
    },
    "requested_role": {
      "$ref": "#/$defs/ProjectRole"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "work-node.v1",
      "default": "work-node.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/LifecycleStatus",
      "default": "DISCOVERED"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "node_id",
    "run_id",
    "kind",
    "capability",
    "requested_role"
  ],
  "title": "WorkNode",
  "type": "object"
}
