{
  "$defs": {
    "ExecutionEnvironment": {
      "description": "Supported execution environments.",
      "enum": [
        "local",
        "kubernetes",
        "gpu_cluster"
      ],
      "title": "ExecutionEnvironment",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Request for GPUs.\n\nThere is intentionally no duration field. A lease is released only after\nthe associated execution pod or job is confirmed terminated.",
  "properties": {
    "architecture": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Architecture"
    },
    "count": {
      "maximum": 8,
      "minimum": 1,
      "title": "Count",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "environment": {
      "$ref": "#/$defs/ExecutionEnvironment",
      "default": "gpu_cluster"
    },
    "image_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Digest"
    },
    "minimum_memory_mb": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimum Memory Mb"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "gpu-request.v1",
      "default": "gpu-request.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "topology": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Topology"
    }
  },
  "required": [
    "request_id",
    "task_id",
    "count"
  ],
  "title": "GpuRequest",
  "type": "object"
}
