{
  "$defs": {
    "PollingTaskStatus": {
      "enum": [
        "idle",
        "running",
        "partial",
        "failed"
      ],
      "title": "PollingTaskStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "enabled": {
      "title": "Enabled",
      "type": "boolean"
    },
    "interval_seconds": {
      "minimum": 30,
      "title": "Interval Seconds",
      "type": "integer"
    },
    "last_completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Completed At"
    },
    "last_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error"
    },
    "last_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Run Id"
    },
    "last_started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Started At"
    },
    "next_run_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Run At"
    },
    "status": {
      "$ref": "#/$defs/PollingTaskStatus",
      "default": "idle"
    },
    "task_id": {
      "const": "github-issue-polling",
      "default": "github-issue-polling",
      "title": "Task Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "enabled",
    "interval_seconds",
    "created_at",
    "updated_at"
  ],
  "title": "PollingTask",
  "type": "object"
}
