{
  "$defs": {
    "ExecutionStatus": {
      "description": "Controller-visible execution lifecycle.",
      "enum": [
        "QUEUED",
        "WAITING_ARTIFACT",
        "WAITING_RESOURCE",
        "ADMITTING",
        "RUNNING",
        "TERMINATING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One authoritative observation of an external execution object.",
  "properties": {
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "duration_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Ms"
    },
    "environment": {
      "additionalProperties": true,
      "title": "Environment",
      "type": "object"
    },
    "execution_id": {
      "title": "Execution Id",
      "type": "string"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "log_refs": {
      "items": {
        "type": "string"
      },
      "title": "Log Refs",
      "type": "array"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "result": {
      "additionalProperties": true,
      "title": "Result",
      "type": "object"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/ExecutionStatus"
    },
    "terminated": {
      "default": false,
      "title": "Terminated",
      "type": "boolean"
    }
  },
  "required": [
    "execution_id",
    "status"
  ],
  "title": "ExecutionObservation",
  "type": "object"
}
