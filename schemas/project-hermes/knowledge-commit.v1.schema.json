      "title": "Schema Version",
      "type": "string"
    },
    "storage_ref": {
      "title": "Storage Ref",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "validated_by": {
      "title": "Validated By",
      "type": "string"
    }
